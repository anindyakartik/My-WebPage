# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/anindya-portfolio
# For MongoDB Atlas (cloud): mongodb+srv://username:password@cluster.mongodb.net/anindya-portfolio

# Admin Credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_EMAIL=anindyakartik@gmail.com
ADMIN_PASSWORD=ChangeMe123!

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-super-secret-session-key-change-this

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient Email (where messages will be sent)
RECIPIENT_EMAIL=anindyakartik@gmail.com

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# SETUP INSTRUCTIONS:
# ============================================================
# 
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 
# MongoDB Setup:
# Option A - Local MongoDB:
#   - Install MongoDB: https://www.mongodb.com/try/download/community
#   - Use: mongodb://localhost:27017/anindya-portfolio
# 
# Option B - MongoDB Atlas (Free Cloud):
#   - Sign up: https://www.mongodb.com/cloud/atlas/register
#   - Create free cluster
#   - Get connection string
#   - Replace username, password, and cluster URL
# 
# Admin Setup:
#   - Change ADMIN_USERNAME, ADMIN_EMAIL, ADMIN_PASSWORD
#   - Use a strong password!
# 
# JWT Secrets:
#   - Generate random strings for JWT_SECRET and SESSION_SECRET
#   - Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# For Gmail:
#   - Enable 2-factor authentication
#   - Generate an App Password: https://myaccount.google.com/apppasswords
#   - Use the App Password as SMTP_PASS
# 
# ============================================================
